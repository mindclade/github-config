{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/organization.schema.json",
  "title": "Mindclade GitHub organization configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "github.mindclade.io/v1" },
    "kind": { "const": "Organization" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "owner_team": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "customProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "required", "allowed_values", "values_editable_by"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
        "value_type": { "const": "single_select" },
        "required": { "type": "boolean" },
        "values_editable_by": { "const": "org_actors" },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 75 }
        }
      }
    },
    "customPropertyMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "legacy_allowed_values"],
      "properties": {
        "phase": { "enum": ["preserve", "retire"] },
        "legacy_allowed_values": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{1,62}$" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 75 }
          }
        }
      }
    },
    "installationDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "app_slug",
            "app_id",
            "installation_id",
            "disposition",
            "integration_id",
            "integration_evidence_digest"
          ],
          "properties": {
            "app_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
            "app_id": { "type": "integer", "minimum": 1 },
            "installation_id": { "type": "integer", "minimum": 1 },
            "disposition": { "const": "catalog" },
            "integration_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
            "integration_evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_slug", "app_id", "installation_id", "disposition", "reason"],
          "properties": {
            "app_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
            "app_id": { "type": "integer", "minimum": 1 },
            "installation_id": { "type": "integer", "minimum": 1 },
            "disposition": { "enum": ["approved_external", "retirement_pending"] },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      ]
    },
    "installationInventoryQualification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authority", "blockers"],
          "properties": {
            "state": { "const": "blocked" },
            "authority": { "const": "bootstrap" },
            "blockers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "authority",
            "source_sha",
            "workflow_ref",
            "created_at",
            "expires_at",
            "installations",
            "evidence_digest"
          ],
          "properties": {
            "state": { "const": "qualified" },
            "authority": { "const": "bootstrap" },
            "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "workflow_ref": {
              "type": "string",
              "pattern": "^mindclade/bootstrap/\\.github/workflows/protected-apply\\.yml@[0-9a-f]{40}$"
            },
            "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
            "installations": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/installationDisposition" }
            },
            "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "founderBootstrapException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "scope",
        "workflow_ref",
        "allowed_operations",
        "denied_operations",
        "single_use_initial_state",
        "single_use_terminal_state",
        "receipt_required",
        "receipt_digest_algorithm",
        "principal_id",
        "github_actor_accounts",
        "minimum_distinct_actor_accounts",
        "independent_principals",
        "production_authority",
        "expires_at"
      ],
      "properties": {
        "id": { "const": "FBE-0001" },
        "state": { "enum": ["UNUSED", "CONSUMED"] },
        "scope": { "const": "founder-bootstrap-only" },
        "workflow_ref": {
          "const": "mindclade/github-config/.github/workflows/protected-apply.yml@refs/heads/main"
        },
        "allowed_operations": {
          "const": ["foundation-plan", "foundation-apply", "foundation-verification"]
        },
        "denied_operations": {
          "const": ["adoption", "enforcement", "production-authority", "exception-replay"]
        },
        "single_use_initial_state": { "const": "UNUSED" },
        "single_use_terminal_state": { "const": "CONSUMED" },
        "receipt_required": { "const": true },
        "receipt_digest_algorithm": { "const": "sha256" },
        "consumption_receipt_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "principal_id": { "const": "founder-primary" },
        "github_actor_accounts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [{ "const": "mindclade-founder" }, { "const": "robpearc" }],
          "items": false
        },
        "minimum_distinct_actor_accounts": { "const": 2 },
        "independent_principals": { "const": false },
        "production_authority": { "const": false },
        "expires_at": { "const": "2026-09-30T23:59:59Z" }
      },
      "oneOf": [
        {
          "properties": { "state": { "const": "UNUSED" } },
          "not": { "required": ["consumption_receipt_digest"] }
        },
        {
          "required": ["consumption_receipt_digest"],
          "properties": { "state": { "const": "CONSUMED" } }
        }
      ]
    },
    "founderPullRequestBypass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "entitlement_id",
        "team",
        "principal_id",
        "github_actor_accounts",
        "durable",
        "bypass_mode",
        "self_authored_pull_requests",
        "all_repositories",
        "all_paths",
        "label",
        "comment_marker",
        "head_sha_required",
        "reason_required",
        "author_must_map_to_principal",
        "foundation_authority",
        "production_authority",
        "fbe_exception_id",
        "activation"
      ],
      "properties": {
        "contract": { "const": "founder-pr-bypass.v1" },
        "entitlement_id": { "const": "founder-pr-bypass" },
        "team": { "const": "founder-pr-bypass" },
        "principal_id": { "const": "founder-primary" },
        "github_actor_accounts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [{ "const": "mindclade-founder" }, { "const": "robpearc" }],
          "items": false
        },
        "durable": { "const": true },
        "bypass_mode": { "const": "pull_request" },
        "self_authored_pull_requests": { "const": true },
        "all_repositories": { "const": true },
        "all_paths": { "const": true },
        "label": { "const": "founder-bypass" },
        "comment_marker": { "const": "<!-- founder-pr-bypass:v1 -->" },
        "head_sha_required": { "const": true },
        "reason_required": { "const": true },
        "author_must_map_to_principal": { "const": true },
        "foundation_authority": { "const": false },
        "production_authority": { "const": false },
        "fbe_exception_id": { "const": "FBE-0001" },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "blockers"],
          "properties": {
            "state": { "enum": ["ready", "blocked"] },
            "blockers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
            }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estate_profile",
        "founder_bootstrap_exception",
        "founder_pull_request_bypass",
        "organization_login",
        "default_repository_permission",
        "members_can_create_repositories",
        "members_can_create_public_repositories",
        "members_can_create_private_repositories",
        "members_can_create_internal_repositories",
        "members_can_create_pages",
        "members_can_fork_private_repositories",
        "web_commit_signoff_required",
        "two_factor_requirement",
        "installation_inventory_qualification",
        "custom_properties",
        "custom_property_migration"
      ],
      "properties": {
        "estate_profile": { "const": "github-enterprise-cloud-mixed" },
        "founder_bootstrap_exception": { "$ref": "#/$defs/founderBootstrapException" },
        "founder_pull_request_bypass": { "$ref": "#/$defs/founderPullRequestBypass" },
        "organization_login": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" },
        "default_repository_permission": { "enum": ["none", "read", "write", "admin"] },
        "members_can_create_repositories": { "type": "boolean" },
        "members_can_create_public_repositories": { "type": "boolean" },
        "members_can_create_private_repositories": { "type": "boolean" },
        "members_can_create_internal_repositories": { "type": "boolean" },
        "members_can_create_pages": { "type": "boolean" },
        "members_can_fork_private_repositories": { "type": "boolean" },
        "web_commit_signoff_required": { "type": "boolean" },
        "two_factor_requirement": { "type": "boolean" },
        "installation_inventory_qualification": {
          "$ref": "#/$defs/installationInventoryQualification"
        },
        "custom_property_migration": { "$ref": "#/$defs/customPropertyMigration" },
        "custom_properties": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/customProperty" }
        }
      }
    }
  }
}
