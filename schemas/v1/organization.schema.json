{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/organization.schema.json",
  "title": "Mindclade GitHub organization configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "github.mindclade.io/v1"},
    "kind": {"const": "Organization"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "owner_team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
      }
    },
    "customProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "required", "allowed_values", "values_editable_by"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"},
        "value_type": {"const": "single_select"},
        "required": {"type": "boolean"},
        "values_editable_by": {"const": "org_actors"},
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 75}
        }
      }
    },
    "customPropertyMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "legacy_allowed_values"],
      "properties": {
        "phase": {"enum": ["preserve", "retire"]},
        "legacy_allowed_values": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,62}$"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 75}
          }
        }
      }
    },
    "installationDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_slug", "app_id", "installation_id", "disposition", "integration_id", "integration_evidence_digest"],
          "properties": {
            "app_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
            "app_id": {"type": "integer", "minimum": 1},
            "installation_id": {"type": "integer", "minimum": 1},
            "disposition": {"const": "catalog"},
            "integration_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
            "integration_evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_slug", "app_id", "installation_id", "disposition", "reason"],
          "properties": {
            "app_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
            "app_id": {"type": "integer", "minimum": 1},
            "installation_id": {"type": "integer", "minimum": 1},
            "disposition": {"enum": ["approved_external", "retirement_pending"]},
            "reason": {"type": "string", "minLength": 1, "maxLength": 500}
          }
        }
      ]
    },
    "installationInventoryQualification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authority", "blockers"],
          "properties": {
            "state": {"const": "blocked"},
            "authority": {"const": "bootstrap"},
            "blockers": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authority", "source_sha", "workflow_ref", "created_at", "expires_at", "installations", "evidence_digest"],
          "properties": {
            "state": {"const": "qualified"},
            "authority": {"const": "bootstrap"},
            "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "workflow_ref": {"type": "string", "pattern": "^mindclade/bootstrap/\\.github/workflows/protected-apply\\.yml@[0-9a-f]{40}$"},
            "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
            "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
            "installations": {
              "type": "array", "uniqueItems": true,
              "items": {"$ref": "#/$defs/installationDisposition"}
            },
            "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_login",
        "default_repository_permission",
        "members_can_create_repositories",
        "members_can_create_public_repositories",
        "members_can_create_private_repositories",
        "members_can_create_internal_repositories",
        "members_can_create_pages",
        "members_can_fork_private_repositories",
        "web_commit_signoff_required",
        "two_factor_requirement",
        "installation_inventory_qualification",
        "custom_properties",
        "custom_property_migration"
      ],
      "properties": {
        "organization_login": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"},
        "default_repository_permission": {"enum": ["none", "read", "write", "admin"]},
        "members_can_create_repositories": {"type": "boolean"},
        "members_can_create_public_repositories": {"type": "boolean"},
        "members_can_create_private_repositories": {"type": "boolean"},
        "members_can_create_internal_repositories": {"type": "boolean"},
        "members_can_create_pages": {"type": "boolean"},
        "members_can_fork_private_repositories": {"type": "boolean"},
        "web_commit_signoff_required": {"type": "boolean"},
        "two_factor_requirement": {"type": "boolean"},
        "installation_inventory_qualification": {"$ref": "#/$defs/installationInventoryQualification"},
        "custom_property_migration": {"$ref": "#/$defs/customPropertyMigration"},
        "custom_properties": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/customProperty"}
        }
      }
    }
  }
}
