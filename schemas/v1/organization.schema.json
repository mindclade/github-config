{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/organization.schema.json",
  "title": "Mindclade GitHub organization configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "github.mindclade.io/v1"},
    "kind": {"const": "Organization"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "owner_team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
      }
    },
    "customProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "required", "allowed_values", "values_editable_by"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$"},
        "value_type": {"const": "single_select"},
        "required": {"type": "boolean"},
        "values_editable_by": {"const": "org_actors"},
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 75}
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_login",
        "default_repository_permission",
        "members_can_create_repositories",
        "members_can_create_public_repositories",
        "members_can_create_private_repositories",
        "members_can_create_internal_repositories",
        "members_can_create_pages",
        "members_can_fork_private_repositories",
        "web_commit_signoff_required",
        "two_factor_requirement",
        "custom_properties"
      ],
      "properties": {
        "organization_login": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"},
        "default_repository_permission": {"enum": ["none", "read", "write", "admin"]},
        "members_can_create_repositories": {"type": "boolean"},
        "members_can_create_public_repositories": {"type": "boolean"},
        "members_can_create_private_repositories": {"type": "boolean"},
        "members_can_create_internal_repositories": {"type": "boolean"},
        "members_can_create_pages": {"type": "boolean"},
        "members_can_fork_private_repositories": {"type": "boolean"},
        "web_commit_signoff_required": {"type": "boolean"},
        "two_factor_requirement": {"type": "boolean"},
        "custom_properties": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/customProperty"}
        }
      }
    }
  }
}
