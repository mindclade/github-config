{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/oidc_policy.schema.json",
  "title": "Mindclade GitHub Actions OIDC policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "github.mindclade.io/v1" },
    "kind": { "const": "OidcPolicy" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "owner_team": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "active_subject_ids", "gated_subject_ids", "blockers"],
      "properties": {
        "state": { "enum": ["BLOCKED", "FOUNDER_BOOTSTRAPPED", "CONNECTED_QUALIFIED"] },
        "exception_ref": { "const": "FBE-0001" },
        "active_subject_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "gated_subject_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "connected_qualification": { "$ref": "#/$defs/connectedQualification" }
      },
      "oneOf": [
        {
          "properties": {
            "state": { "const": "BLOCKED" },
            "active_subject_ids": {
              "const": [
                "bootstrap-protected-plan",
                "bootstrap-protected-apply",
                "bootstrap-recovery-verification",
                "infrastructure-live-development-plan",
                "infrastructure-live-development-apply",
                "infrastructure-live-staging-plan",
                "infrastructure-live-staging-apply",
                "infrastructure-live-production-plan",
                "infrastructure-live-production-apply",
                "infrastructure-live-restricted-plan",
                "infrastructure-live-restricted-apply"
              ]
            },
            "gated_subject_ids": {
              "const": [
                "github-config-drift-plan",
                "github-config-protected-plan",
                "github-config-protected-apply",
                "infrastructure-drift-plan",
                "infrastructure-ci-evidence-verifier"
              ]
            },
            "blockers": {
              "const": [
                "github-config-control-plane-federation-not-connected-qualified",
                "infrastructure-drift-federation-not-connected-qualified",
                "ci-evidence-federation-not-connected-qualified"
              ]
            }
          },
          "not": {
            "anyOf": [
              { "required": ["exception_ref"] },
              { "required": ["connected_qualification"] }
            ]
          }
        },
        {
          "required": ["exception_ref"],
          "properties": {
            "state": { "const": "FOUNDER_BOOTSTRAPPED" },
            "exception_ref": { "const": "FBE-0001" },
            "active_subject_ids": {
              "const": [
                "bootstrap-protected-plan",
                "bootstrap-protected-apply",
                "bootstrap-recovery-verification",
                "infrastructure-live-development-plan",
                "infrastructure-live-development-apply",
                "infrastructure-live-staging-plan",
                "infrastructure-live-staging-apply",
                "infrastructure-live-production-plan",
                "infrastructure-live-production-apply",
                "infrastructure-live-restricted-plan",
                "infrastructure-live-restricted-apply",
                "github-config-drift-plan",
                "github-config-protected-plan",
                "github-config-protected-apply",
                "infrastructure-drift-plan",
                "infrastructure-ci-evidence-verifier"
              ]
            },
            "gated_subject_ids": { "const": [] },
            "blockers": {
              "const": [
                "independent-review-not-connected-qualified",
                "production-authority-disabled"
              ]
            }
          },
          "not": { "required": ["connected_qualification"] }
        },
        {
          "required": ["connected_qualification"],
          "properties": {
            "state": { "const": "CONNECTED_QUALIFIED" },
            "active_subject_ids": {
              "const": [
                "bootstrap-protected-plan",
                "bootstrap-protected-apply",
                "bootstrap-recovery-verification",
                "infrastructure-live-development-plan",
                "infrastructure-live-development-apply",
                "infrastructure-live-staging-plan",
                "infrastructure-live-staging-apply",
                "infrastructure-live-production-plan",
                "infrastructure-live-production-apply",
                "infrastructure-live-restricted-plan",
                "infrastructure-live-restricted-apply",
                "github-config-drift-plan",
                "github-config-protected-plan",
                "github-config-protected-apply",
                "infrastructure-drift-plan",
                "infrastructure-ci-evidence-verifier"
              ]
            },
            "gated_subject_ids": { "const": [] },
            "blockers": { "const": [] }
          },
          "not": { "required": ["exception_ref"] }
        }
      ]
    },
    "connectedQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_sha",
        "workflow_ref",
        "independent_principal_ids",
        "created_at",
        "expires_at",
        "evidence_digest"
      ],
      "properties": {
        "authority": { "const": "bootstrap" },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflow_ref": {
          "type": "string",
          "pattern": "^mindclade/bootstrap/\\.github/workflows/protected-apply\\.yml@[0-9a-f]{40}$"
        },
        "independent_principal_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
        },
        "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "evidence_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["ref", "environment"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "workflow",
        "context",
        "audience",
        "require_immutable_workflow_ref",
        "workload_identity_provider_ref",
        "service_account_ref"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$" },
        "workflow": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
        },
        "context": { "$ref": "#/$defs/context" },
        "audience": {
          "oneOf": [
            { "const": "canonical-provider-resource" },
            { "type": "string", "pattern": "^(?:sts\\.googleapis\\.com|https://\\S{1,247})$" }
          ]
        },
        "require_immutable_workflow_ref": { "type": "boolean" },
        "workload_identity_provider_ref": {
          "enum": [
            "github-config-plan",
            "github-config-apply",
            "github-actions-plan",
            "github-actions-apply",
            "github-actions-recovery",
            "infrastructure-plan",
            "development-plan",
            "development-apply",
            "staging-plan",
            "staging-apply",
            "production-plan",
            "production-apply",
            "restricted-plan",
            "restricted-apply",
            "verifier"
          ]
        },
        "service_account_ref": {
          "enum": [
            "github-config-plan",
            "github-config-apply",
            "bootstrap-plan",
            "bootstrap-apply",
            "bootstrap-recovery",
            "infrastructure-plan",
            "development-plan",
            "development-apply",
            "staging-plan",
            "staging-apply",
            "production-plan",
            "production-apply",
            "restricted-plan",
            "restricted-apply",
            "ci-evidence-verifier"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "use_default_subject",
        "use_immutable_subject",
        "include_claim_keys",
        "audiences",
        "subjects",
        "activation"
      ],
      "properties": {
        "issuer": { "const": "https://token.actions.githubusercontent.com" },
        "use_default_subject": { "type": "boolean" },
        "use_immutable_subject": { "type": "boolean" },
        "include_claim_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["repo", "context", "workflow_ref", "workflow_sha"] }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "const": "canonical-provider-resource" },
              { "type": "string", "pattern": "^(?:sts\\.googleapis\\.com|https://\\S{1,247})$" }
            ]
          }
        },
        "subjects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/subject" } },
        "activation": { "$ref": "#/$defs/activation" }
      }
    }
  }
}
