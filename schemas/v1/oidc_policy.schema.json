{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/oidc_policy.schema.json",
  "title": "Mindclade GitHub Actions OIDC policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "github.mindclade.io/v1"},
    "kind": {"const": "OidcPolicy"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "owner_team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers"],
      "properties": {
        "state": {"enum": ["ready", "blocked"]},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["ref", "environment"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "workflow", "context", "audience", "require_immutable_workflow_ref", "workload_identity_provider_ref", "service_account_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
        "workflow": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "context": {"$ref": "#/$defs/context"},
        "audience": {
          "oneOf": [
            {"const": "canonical-provider-resource"},
            {"type": "string", "pattern": "^(?:sts\\.googleapis\\.com|https://\\S{1,247})$"}
          ]
        },
        "require_immutable_workflow_ref": {"type": "boolean"},
        "workload_identity_provider_ref": {"enum": ["github-config-plan", "github-config-apply", "github-actions-plan", "github-actions-apply", "github-actions-recovery", "infrastructure-plan", "development-plan", "development-apply", "staging-plan", "staging-apply", "production-plan", "production-apply", "restricted-plan", "restricted-apply", "verifier"]},
        "service_account_ref": {"enum": ["github-config-plan", "github-config-apply", "bootstrap-plan", "bootstrap-apply", "bootstrap-recovery", "infrastructure-plan", "development-plan", "development-apply", "staging-plan", "staging-apply", "production-plan", "production-apply", "restricted-plan", "restricted-apply", "ci-evidence-verifier"]}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "use_default_subject", "use_immutable_subject", "include_claim_keys", "audiences", "subjects", "activation"],
      "properties": {
        "issuer": {"const": "https://token.actions.githubusercontent.com"},
        "use_default_subject": {"type": "boolean"},
        "use_immutable_subject": {"type": "boolean"},
        "include_claim_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["repo", "context", "workflow_ref", "workflow_sha"]}
        },
        "audiences": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "oneOf": [
              {"const": "canonical-provider-resource"},
              {"type": "string", "pattern": "^(?:sts\\.googleapis\\.com|https://\\S{1,247})$"}
            ]
          }
        },
        "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
        "activation": {"$ref": "#/$defs/activation"}
      }
    }
  }
}
