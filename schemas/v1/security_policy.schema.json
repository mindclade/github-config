{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/security_policy.schema.json",
  "title": "Mindclade GitHub security policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "github.mindclade.io/v1"},
    "kind": {"const": "SecurityPolicy"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "owner_team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers"],
      "properties": {
        "state": {"enum": ["ready", "blocked"]},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_manager_team",
        "dependency_graph_required",
        "dependabot_alerts_required",
        "dependabot_security_updates_required",
        "advanced_security_required",
        "code_scanning_default_setup_required",
        "secret_scanning_required",
        "secret_scanning_push_protection_required",
        "private_vulnerability_reporting_required",
        "required_capabilities",
        "activation"
      ],
      "properties": {
        "security_manager_team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "dependency_graph_required": {"type": "boolean"},
        "dependabot_alerts_required": {"type": "boolean"},
        "dependabot_security_updates_required": {"type": "boolean"},
        "advanced_security_required": {"type": "boolean"},
        "code_scanning_default_setup_required": {"type": "boolean"},
        "secret_scanning_required": {"type": "boolean"},
        "secret_scanning_push_protection_required": {"type": "boolean"},
        "private_vulnerability_reporting_required": {"type": "boolean"},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["github-enterprise-cloud", "github-advanced-security"]}
        },
        "activation": {"$ref": "#/$defs/activation"}
      }
    }
  }
}
