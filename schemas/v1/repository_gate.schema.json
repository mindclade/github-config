{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.mindclade.io/schemas/v1/repository_gate.schema.json",
  "title": "Mindclade repository authority gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "github.mindclade.io/v1"},
    "kind": {"const": "RepositoryGate"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner_team"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
        "owner_team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers"],
      "properties": {
        "state": {"enum": ["ready", "blocked"]},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}
      }
    },
    "statusCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "issuer_type", "workflow_path", "triggers"],
      "properties": {
        "context": {"type": "string", "minLength": 1, "maxLength": 100},
        "issuer_type": {"const": "github_actions"},
        "integration_id": {"type": "integer", "minimum": 1},
        "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "triggers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["pull_request", "merge_group"]}}
      }
    },
    "requiredStatusChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strict", "checks"],
      "properties": {
        "strict": {"type": "boolean"},
        "checks": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/statusCheck"}}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "target", "enforcement", "include_refs", "exclude_refs", "bypass_actors", "required_status_checks", "required_deployments", "activation"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,99}$"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
        "target": {"const": "branch"},
        "enforcement": {"enum": ["active", "evaluate", "disabled"]},
        "include_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclude_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "bypass_actors": {"type": "array", "maxItems": 0},
        "required_status_checks": {"$ref": "#/$defs/requiredStatusChecks"},
        "required_deployments": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"}},
        "activation": {"$ref": "#/$defs/activation"}
      }
    }
  }
}
