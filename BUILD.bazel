load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "blueprint_source_tree",
    srcs = glob(
        [
            "**/*",
            ".*",
            ".github/**/*",
            ".vscode/**/*",
        ],
        exclude = [
            ".git/**",
            "**/.terraform/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "bazel-*/**",
        ],
    ) + [
        "//compiler:source_tree",
    ],
)

filegroup(
    name = "generated_policy_sources",
    srcs = [
        "generated/bazelrc.common",
        "generated/nix-bazel-policy.lock.json",
        "generated/nix-bazel-policy.nix",
        "generated/toolchain-manifest.defaults.json",
    ],
)

filegroup(
    name = "catalog_sources",
    srcs = glob([
        "config/**/*.yaml",
        "schemas/v1/*.json",
    ]) + [":generated_policy_sources"],
)

filegroup(
    name = "workflow_sources",
    srcs = glob([".github/workflows/*.yml"]),
)

filegroup(
    name = "opentofu_sources",
    srcs = glob(["opentofu/**/*.tf"]),
)

genrule(
    name = "policy_input",
    srcs = [
        ":catalog_sources",
        ":workflow_sources",
        "component.yaml",
    ],
    outs = ["policy-input.json"],
    cmd = """
set -eu
temporary="$$(mktemp -d \"$(@D)/policy-input-root.XXXXXX\")"
trap 'rm -rf "$$temporary"' EXIT
for source in $(SRCS); do
  relative="$${source#./}"
  mkdir -p "$$temporary/$$(dirname "$$relative")"
  cp -L "$$source" "$$temporary/$$relative"
done
$(location //compiler:github-configctl) --root "$$temporary" policy-input --output "$@"
""",
    tools = ["//compiler:github-configctl"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "catalog_schema_test",
    size = "small",
    srcs = ["tests/contract/test_catalog_schema.py"],
    args = ["$(rootpath //compiler:github-configctl)"],
    data = [
        ":blueprint_source_tree",
        ":catalog_sources",
        ":workflow_sources",
        "//compiler:github-configctl",
    ],
    legacy_create_init = 0,
    main = "tests/contract/test_catalog_schema.py",
)

