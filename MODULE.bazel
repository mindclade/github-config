module(
    name = "github_config",
    version = "1.0.0",
    bazel_compatibility = [
        ">=9.1.1",
        "<=9.1.1",
    ],
)

bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_python", version = "2.3.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.7")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

# Dependabot stages nested files by matching *_from_file assignments in the
# raw module text before regenerating MODULE.bazel.lock. Keep both literals.
go_mod_from_file = "//compiler:go.mod"

# Dependabot staging hint: go_sum_from_file = "//compiler:go.sum"

go_deps.from_file(go_mod = go_mod_from_file)
use_repo(
    go_deps,
    "com_github_santhosh_tekuri_jsonschema_v5",
    "in_gopkg_yaml_v3",
)
