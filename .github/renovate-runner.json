{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platform": "github",
  "endpoint": "https://api.github.com/",
  "autodiscover": false,
  "onboarding": false,
  "requireConfig": "required",
  "repositories": [
    "mindclade/.github",
    "mindclade/bootstrap",
    "mindclade/estate-ci",
    "mindclade/github-config",
    "mindclade/gitops",
    "mindclade/infrastructure-live",
    "mindclade/mindclade"
  ],
  "allowedUnsafeExecutions": ["bazelModDeps"],
  "allowedCommands": [],
  "allowPostUpgradeCommandTemplating": false,
  "allowScripts": false,
  "allowCustomCrateRegistries": false,
  "allowPlugins": false,
  "binarySource": "install",
  "persistRepoData": false,
  "printConfig": false,
  "gitAuthor": "Mindclade Renovate <mindclade-renovate[bot]@users.noreply.github.com>"
}
